DATABASE_URL=sqlite:////app/backend/visitors.db
# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://visitor:visitor@postgres:5432/visitor_system
FRONTEND_WEB_DIR=/app/frontend/web
JWT_SECRET_KEY=replace-this-with-at-least-32-random-bytes
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
DEFAULT_ADMIN_USERNAME=madao
DEFAULT_ADMIN_PASSWORD=666666
APPOINTMENT_EXPIRE_HOURS=48
AUTO_EXPIRE_ENABLED=true
AUTO_EXPIRE_INTERVAL_MINUTES=60
DATABASE_WAIT_TIMEOUT_SECONDS=30
DATABASE_WAIT_INTERVAL_SECONDS=1
LOG_LEVEL=INFO
LOG_DIR=/app/backend/logs
# Optional when Web and API are deployed on different origins:
# CORS_ALLOW_ORIGINS=https://visitor.example.com,http://127.0.0.1:3000
