DATABASE_URL=sqlite:////app/visitors.db
# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://visitor:visitor@postgres:5432/visitor_system
JWT_SECRET_KEY=replace-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123456
APPOINTMENT_EXPIRE_HOURS=48
AUTO_EXPIRE_ENABLED=true
AUTO_EXPIRE_INTERVAL_MINUTES=60
DATABASE_WAIT_TIMEOUT_SECONDS=30
DATABASE_WAIT_INTERVAL_SECONDS=1
LOG_LEVEL=INFO
LOG_DIR=/app/logs
