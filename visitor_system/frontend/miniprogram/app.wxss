page {
  background: #f6f3ee;
  color: #1f2933;
  font-family: "PingFang SC", sans-serif;
}

.page-shell {
  padding: 32rpx;
}

.panel {
  background: #fffdf8;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 16rpx 32rpx rgba(31, 41, 51, 0.08);
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.desc {
  color: #52606d;
  line-height: 1.7;
}

