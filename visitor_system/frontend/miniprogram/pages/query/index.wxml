<view class="page-shell">
  <view class="panel query-panel">
    <view class="title">进度查询</view>
    <view class="desc">输入预约时填写的手机号，即可查看最近一次申请的审批状态、入场码和电子凭证入口。</view>

    <view class="field-card">
      <view class="field">
        <text class="label">手机号</text>
        <input value="{{phone}}" placeholder="请输入预约手机号" type="number" bindinput="handleInput" />
      </view>
      <button class="submit-button" loading="{{querying}}" bindtap="handleQuery">查询进度</button>
    </view>

    <view class="action-row top-actions">
      <button class="secondary-button" bindtap="openApplyPage">去预约</button>
      <button class="secondary-button" bindtap="openHomePage">返回首页</button>
    </view>

    <view wx:if="{{result}}" class="result-box">
      <view class="result-head">
        <view class="status-chip status-{{result.statusTone}}">{{result.statusText}}</view>
        <view class="status-summary">当前申请状态已更新</view>
      </view>

      <view class="status-note">{{result.statusNote}}</view>

      <view class="highlight-card">
        <view class="highlight-label">入场码</view>
        <view class="result-code">{{result.access_code}}</view>
      </view>

      <view class="detail-grid">
        <view class="result-row">
          <text class="result-label">访客姓名</text>
          <text class="result-value">{{result.name}}</text>
        </view>
        <view class="result-row">
          <text class="result-label">预约时间</text>
          <text class="result-value">{{result.appointmentTimeText}}</text>
        </view>
        <view class="result-row">
          <text class="result-label">受访人</text>
          <text class="result-value">{{result.target_person}}</text>
        </view>
        <view class="result-row">
          <text class="result-label">审批备注</text>
          <text class="result-value">{{result.adminRemarkText}}</text>
        </view>
        <view class="result-row">
          <text class="result-label">审批人</text>
          <text class="result-value">{{result.approvedByText}}</text>
        </view>
        <view class="result-row">
          <text class="result-label">审批时间</text>
          <text class="result-value">{{result.approvedAtText}}</text>
        </view>
        <view class="result-row">
          <text class="result-label">签到时间</text>
          <text class="result-value">{{result.checkedInAtText}}</text>
        </view>
      </view>

      <view class="action-row">
        <button class="secondary-button" bindtap="handleCopyCode">复制入场码</button>
        <button class="submit-button compact-button" bindtap="openPassPage">查看电子凭证</button>
      </view>
    </view>
  </view>
</view>
