.query-panel {
  background: linear-gradient(180deg, #fffefb 0%, #f8fcfb 100%);
}

.field-card {
  margin-top: 26rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #f7fbfa;
  border: 1rpx solid rgba(15, 118, 110, 0.08);
}

.field {
  margin-top: 0;
}

.label {
  display: block;
  margin-bottom: 10rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #163635;
}

input {
  width: 100%;
  background: #ffffff;
  border-radius: 18rpx;
  padding: 22rpx 20rpx;
  min-height: 88rpx;
  box-sizing: border-box;
  border: 1rpx solid #d7e5e1;
}

.submit-button {
  margin-top: 18rpx;
  background: #0f766e;
  color: #ffffff;
  border-radius: 999rpx;
}

.compact-button {
  margin-top: 0;
}

.top-actions {
  margin-top: 20rpx;
}

.result-box {
  margin-top: 28rpx;
  padding: 24rpx;
  background: linear-gradient(145deg, rgba(15, 118, 110, 0.08), rgba(255, 255, 255, 0.98));
  border-radius: 24rpx;
  border: 1rpx solid rgba(15, 118, 110, 0.08);
}

.result-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
}

.status-summary {
  font-size: 24rpx;
  color: #5b6b73;
}

.status-chip {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.status-pending {
  background: #fef3c7;
  color: #92400e;
}

.status-approved {
  background: #dcfce7;
  color: #166534;
}

.status-rejected {
  background: #fee2e2;
  color: #991b1b;
}

.status-expired {
  background: #e5e7eb;
  color: #4b5563;
}

.status-note {
  margin: 16rpx 0 18rpx;
  color: #52606d;
  line-height: 1.7;
}

.highlight-card {
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: inset 0 0 0 1rpx #d7e5e1;
}

.highlight-label {
  font-size: 24rpx;
  color: #5b6b73;
}

.result-code {
  margin-top: 10rpx;
  font-size: 42rpx;
  font-weight: 800;
  letter-spacing: 6rpx;
  color: #0b5d74;
}

.detail-grid {
  margin-top: 18rpx;
}

.result-row {
  margin-bottom: 14rpx;
  padding-bottom: 14rpx;
  border-bottom: 1rpx dashed rgba(125, 147, 160, 0.28);
}

.result-row:last-child {
  margin-bottom: 0;
  padding-bottom: 0;
  border-bottom: 0;
}

.result-label {
  display: block;
  color: #52606d;
  margin-bottom: 6rpx;
  font-size: 24rpx;
}

.result-value {
  color: #102a2c;
  line-height: 1.6;
}

.action-row {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 24rpx;
}

.secondary-button {
  background: #ffffff;
  color: #0f766e;
  border: 1rpx solid #0f766e;
  border-radius: 999rpx;
}
