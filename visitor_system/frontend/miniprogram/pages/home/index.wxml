<view class="page">
  <view class="hero">
    <view class="hero-tag">VISITOR PASS</view>
    <view class="title">{{title}}</view>
    <view class="subtitle">线上提交来访申请，审批通过后即可出示电子凭证与二维码，现场扫码快速入场。</view>

    <view class="hero-points">
      <view class="hero-point">预约申请</view>
      <view class="hero-point">进度查询</view>
      <view class="hero-point">电子凭证</view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">快捷入口</view>
    <view class="action-list">
      <block wx:for="{{actions}}" wx:key="key">
        <button class="action-button" data-path="{{item.path}}" bindtap="handleNavigate">
          <view class="action-label">{{item.label}}</view>
          <view class="action-desc">{{item.key === 'apply' ? '填写来访信息并提交审批' : '输入手机号查看最新状态'}}</view>
        </button>
      </block>
    </view>
  </view>

  <view wx:if="{{recentPhone}}" class="recent-card">
    <view class="recent-header">
      <view class="section-title">最近查询</view>
      <view class="recent-badge">已记住</view>
    </view>
    <view class="recent-phone">{{recentPhone}}</view>
    <view class="recent-tip">可直接继续查看最近一次预约的审批状态与电子凭证。</view>
    <button class="secondary-action" bindtap="handleQuickQuery">继续查询进度</button>
  </view>

  <view class="guide-card">
    <view class="section-title">使用说明</view>
    <view class="guide-item">1. 填写预约信息并提交申请</view>
    <view class="guide-item">2. 等待管理员审批结果</view>
    <view class="guide-item">3. 通过后出示电子凭证和二维码</view>
  </view>
</view>
