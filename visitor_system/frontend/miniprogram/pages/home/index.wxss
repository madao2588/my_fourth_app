.page {
  min-height: 100vh;
  padding: 28rpx;
  background:
    radial-gradient(circle at top right, rgba(15, 118, 110, 0.12), transparent 34%),
    linear-gradient(180deg, #f5f8f7 0%, #eef4f2 100%);
}

.hero {
  padding: 40rpx 32rpx;
  border-radius: 32rpx;
  background: linear-gradient(145deg, #0f766e, #115e59);
  color: #f8fafc;
  box-shadow: 0 20rpx 44rpx rgba(15, 118, 110, 0.22);
}

.hero-tag {
  display: inline-block;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

.title {
  margin-top: 18rpx;
  font-size: 48rpx;
  font-weight: 700;
}

.subtitle {
  margin-top: 18rpx;
  font-size: 28rpx;
  line-height: 1.75;
  color: rgba(248, 250, 252, 0.9);
}

.hero-points {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 26rpx;
}

.hero-point {
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.14);
  font-size: 24rpx;
}

.section {
  margin-top: 28rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #163635;
}

.action-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 18rpx;
}

.action-button {
  padding: 26rpx 28rpx;
  border-radius: 26rpx;
  background: #ffffff;
  color: #0f172a;
  text-align: left;
  box-shadow: 0 14rpx 30rpx rgba(15, 23, 42, 0.06);
  border: 1rpx solid rgba(15, 118, 110, 0.08);
}

.action-label {
  font-size: 32rpx;
  font-weight: 700;
  color: #0f172a;
}

.action-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #5b6b73;
}

.recent-card,
.guide-card {
  margin-top: 28rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 30rpx rgba(15, 23, 42, 0.06);
}

.recent-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.recent-badge {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #d1fae5;
  color: #065f46;
  font-size: 22rpx;
  font-weight: 600;
}

.recent-phone {
  margin-top: 16rpx;
  font-size: 40rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
  color: #102a2c;
}

.recent-tip {
  margin-top: 12rpx;
  color: #5b6b73;
  line-height: 1.7;
  font-size: 26rpx;
}

.secondary-action {
  margin-top: 20rpx;
  border-radius: 999rpx;
  background: #e6fffb;
  color: #0f766e;
  border: 1rpx solid #99f6e4;
}

.guide-item {
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: #f8fafc;
  color: #44525a;
  line-height: 1.6;
  font-size: 26rpx;
}
